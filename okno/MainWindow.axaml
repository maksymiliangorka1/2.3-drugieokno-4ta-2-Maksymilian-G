<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="900"
        Width="900"
        Height="900"
        x:Class="okno.MainWindow"
        Title="Zadanie 2.3"
        Background="Gray">
    <Border BorderBrush="White" BorderThickness="6">
        <Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <TextBlock Text="Użyłem agenta"
                           HorizontalAlignment="Center"
                           FontStyle="Italic"
                           FontSize="28" />
                <TextBlock Text="Moja aplikacja Avalonia"
                           HorizontalAlignment="Center" />
                <Button Content="Kliknij mnie"
                        HorizontalAlignment="Center">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Green" />
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Content="Nie klikaj mnie"
                        HorizontalAlignment="Center">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Red" />
                        </Style>
                    </Button.Styles>
                </Button>
                <CheckBox Content="TAK"
                          HorizontalAlignment="Center" />
                <CheckBox Content="NIE"
                          HorizontalAlignment="Center" />
                <Slider Width="200"
                        Minimum="0"
                        Maximum="100"
                        Value="50"
                        HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Maksymilian Górka"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="12"
                       FontSize="11"
                       Opacity="0.5" />
        </Grid>
    </Border>
</Window>
